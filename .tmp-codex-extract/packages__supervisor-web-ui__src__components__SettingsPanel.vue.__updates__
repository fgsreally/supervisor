           <label class="settings-field">
             <span>颜色模式</span>
             <select :value="isDark ? 'dark' : 'light'" @change="changeColorMode">
               <option value="light">亮色</option>
               <option value="dark">暗色</option>
             </select>
           </label>
+          <label class="settings-field">
+            <span>字号</span>
+            <select :value="fontScale" @change="changeFontScale">
+              <option value="compact">紧凑</option>
