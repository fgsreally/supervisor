{
  "appId": "com.supervisor.app",
  "appName": "Supervisor",
  "webDir": "../supervisor-web-ui/dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#07c160"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "iconColor": "#07c160"
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
