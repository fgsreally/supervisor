{
  "name": "wecode",
  "version": "0.1.0",
  "description": "WeCode runtime for managing multiple agent sessions",
  "bin": {
    "wecode": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    ".env.example",
    "WECODE.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./test": {
      "types": "./dist/testing/ai/index.d.ts",
      "import": "./dist/testing/ai/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "tsup --watch",
    "serve:dev": "cross-env WECODE_DEV=1 WECODE_UI_PORT=5163 node --watch --watch-path=src --watch-preserve-output ./node_modules/esno/esno.js --loader ./scripts/md-loader.mjs src/cli.ts serve --port 3042 --cwd ../../playground --password 123456",
    "serve:playground": "esno --loader ./scripts/md-loader.mjs src/cli.ts serve --port 3040 --cwd ../../playground --password 123456",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && shx rm -rf dist/sql dist/migrations dist/i18n && shx cp -r src/db/sql dist/sql && shx cp -r src/db/migrations dist/migrations && shx mkdir -p dist/i18n && shx cp -r src/i18n/locales dist/i18n/locales",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest --run --config vitest.config.ts",
    "test:unit": "vitest --run --config vitest.config.ts",
    "test:ai": "vitest --run --config vitest.ai.config.ts",
    "test:all": "pnpm run test:unit && pnpm run test:ai"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.23.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "^0.98.1",
    "@ast-grep/napi": "^0.44.1",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@elysia/node": "^1.4.6",
    "@elysia/openapi": "^1.4.15",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@injaneity/pi-computer-use": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.0",
    "boxen": "^8.0.1",
    "cac": "^7.0.0",
    "cloudflared": "^0.7.1",
    "debug": "^4.4.3",
    "elysia": "^1.4.29",
    "ignore": "^6.0.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1",
    "prompts": "^2.4.2",
    "qrcode-terminal": "^0.12.0",
    "sherpa-onnx-node": "^1.13.4",
    "typebox": "^1.3.3",
    "typescript": "^5.7.3",
    "uuid": "^14.0.0",
    "ws": "8.21.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/prompts": "^2.4.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "8.18.1",
    "cross-env": "^7.0.3",
    "esno": "4.8.0",
    "shx": "^0.4.0",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
