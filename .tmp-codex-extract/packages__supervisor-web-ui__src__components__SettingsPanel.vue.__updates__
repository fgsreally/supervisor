+              <option value="large">大字号</option>
+            </select>
+          </label>
@@
 import { useAppStyle, type AppStyle } from "@/composables/use-app-style";
+import {
+  useAppFontScale,
+  type AppFontScale,
+} from "@/composables/use-app-font-scale";
@@
 const { style: appStyle, setStyle: setAppStyle } = useAppStyle();
 const { isDark, setDark } = useAppTheme();
+const { fontScale, setFontScale } = useAppFontScale();
@@
 function changeColorMode(event: Event) {
   setDark((event.target as HTMLSelectElement).value === "dark");
 }
+
+function changeFontScale(event: Event) {
+  setFontScale((event.target as HTMLSelectElement).value as AppFontScale);
+}
