+    <div v-if="open" class="intro-layer" :class="{ 'intro-layer--mobile': mobile }">
@@
-        <div v-if="current.kind === 'nav'" class="intro-action-hint">
-          <MousePointer2 />请点击高亮的“{{ current.navLabel }}”图标
+        <div v-if="current.kind === 'nav'" class="intro-action-hint">
