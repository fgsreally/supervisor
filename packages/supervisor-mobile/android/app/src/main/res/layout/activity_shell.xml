<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weui_bg_page">

    <WebView
        android:id="@+id/shell_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/shell_list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/shell_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/weui_bg_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/shell_list_title"
                android:textColor="@color/weui_fg_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/shell_scan_header_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shell_scan_button"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/shell_scan_icon" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/weui_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/shell_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="72dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/shell_empty_title"
                        android:textColor="@color/weui_fg_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/shell_empty_hint"
                        android:textColor="@color/weui_fg_desc"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shell_scan_button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/shell_primary_button"
                        android:gravity="center"
                        android:minWidth="184dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/shell_scan_button"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/shell_section_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/shell_list_section"
                    android:textColor="@color/weui_fg_desc"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/shell_instance_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/weui_bg_primary"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
