@media (max-width: 767px) {
  .mobile-app-shell .chat-view,
  .mobile-app-shell .chat-row {
    background: var(--m-chat-bg) !important;
  }

  .mobile-app-shell .chat-message-list {
    padding-inline: 6px !important;
  }

  .mobile-app-shell .chat-row {
    padding: 3px 0 !important;
  }

  .mobile-app-shell .assistant-message-row,
  .mobile-app-shell .user-message-row {
    display: grid !important;
    width: 100%;
    gap: 4px 6px !important;
    align-items: center !important;
  }

  .mobile-app-shell .assistant-message-row {
    grid-template-columns: 24px minmax(0, 1fr);
  }

  .mobile-app-shell .user-message-row {
    grid-template-columns: minmax(0, 1fr) 24px;
  }

  .mobile-app-shell .assistant-message-row .chat-avatar,
  .mobile-app-shell .chat-message-list > .chat-avatar {
    width: 24px !important;
    height: 24px !important;
    font-size: 10px !important;
  }

  .mobile-app-shell .user-message-row .chat-avatar--user {
    display: grid !important;
    grid-column: 2;
    grid-row: 1;
    width: 24px !important;
    height: 24px !important;
    font-size: 10px !important;
  }

  .mobile-app-shell .assistant-message-row > .chat-avatar {
    grid-column: 1;
    grid-row: 1;
  }

  .mobile-app-shell .assistant-message-body,
  .mobile-app-shell .user-message-row > :first-child {
    display: contents !important;
  }

  .mobile-app-shell .assistant-message-row .chat-msg-time {
    grid-column: 2;
    grid-row: 1;
    margin: 0 !important;
  }

  .mobile-app-shell .user-message-row .user-message-meta {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    margin: 0 !important;
  }

  .mobile-app-shell .assistant-message-row > .chat-bubble,
  .mobile-app-shell .assistant-message-body > .chat-bubble {
    grid-column: 1 / -1;
    grid-row: 2;
    width: fit-content !important;
    max-width: 100% !important;
    justify-self: start;
  }

  .mobile-app-shell .user-message-row .chat-bubble,
  .mobile-app-shell .user-message-row .chat-file-bubble,
  .mobile-app-shell .user-message-row > :first-child > :not(.user-message-meta):not(.chat-msg-delivery) {
    grid-column: 1 / -1;
    grid-row: 2;
    max-width: 100% !important;
    justify-self: end;
  }

  .mobile-app-shell .user-message-row .chat-msg-delivery {
    grid-column: 1 / -1;
    justify-self: end;
  }

  .mobile-app-shell .chat-bubble {
    padding: 8px 10px !important;
    font-size: 15px;
    line-height: 1.58;
  }

  .mobile-app-shell .assistant-message-row .chat-bubble {
    background: var(--m-bubble-assistant) !important;
  }

  .mobile-app-shell .assistant-message-row .chat-bubble-tail {
    background: var(--m-bubble-assistant) !important;
  }

  .mobile-app-shell .user-message-row .chat-bubble--user {
    background: var(--m-bubble-user) !important;
  }

  .mobile-app-shell .user-message-row .chat-bubble-tail {
    background: var(--m-bubble-user) !important;
  }

  .mobile-app-shell .chat-bubble-tail {
    display: none !important;
  }

  .mobile-app-shell .chat-msg-time {
    font-size: 10px;
    line-height: 1;
  }

  .mobile-app-shell .assistant-message-content {
    gap: 4px !important;
  }
}
