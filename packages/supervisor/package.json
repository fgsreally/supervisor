{
  "name": "pi-supervisor",
  "version": "0.1.0",
  "description": "Supervisor for managing multiple pi agent sessions",
  "bin": {
    "pi-supervisor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "agents",
    "prompts",
    ".env.example",
    "SUPERVISOR.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./test": {
      "types": "./dist/testing/ai/index.d.mts",
      "import": "./dist/testing/ai/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "tsdown --watch",
    "serve:playground": "bun dist/cli.mjs serve --port 3030 --cwd ../../playground --password 123456",
    "build": "tsdown && shx cp -r src/db/sql dist/sql",
    "test": "vitest --run --config vitest.config.ts",
    "test:unit": "vitest --run --config vitest.config.ts",
    "test:ai": "vitest --run --config vitest.ai.config.ts",
    "test:all": "pnpm run test:unit && pnpm run test:ai"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.23.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "^0.98.1",
    "@ast-grep/napi": "^0.44.1",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@elysia/openapi": "^1.4.15",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@injaneity/pi-computer-use": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cac": "^7.0.0",
    "cloudflared": "^0.7.1",
    "elysia": "^1.4.29",
    "ignore": "^6.0.2",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "prompts": "^2.4.2",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.3.3",
    "typescript": "^5.7.3",
    "uuid": "^14.0.0",
    "ws": "8.21.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/prompts": "^2.4.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "8.18.1",
    "shx": "^0.4.0",
    "tsdown": "^0.22.3",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.6.0"
  }
}
