<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/shell_dialog_background" android:orientation="vertical"
    android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="移除这个连接？" android:textColor="#171A24" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/shell_delete_description" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp"
        android:textColor="#6F7787" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="end" android:orientation="horizontal">
        <TextView android:id="@+id/shell_delete_cancel" android:layout_width="wrap_content"
            android:layout_height="44dp" android:gravity="center" android:paddingStart="20dp"
            android:paddingEnd="20dp" android:text="取消" android:textColor="#596273" android:textSize="15sp" />
        <TextView android:id="@+id/shell_delete_confirm_custom" android:layout_width="wrap_content"
            android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/shell_status_pill_offline"
            android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:text="删除连接" android:textColor="#E5484D" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
