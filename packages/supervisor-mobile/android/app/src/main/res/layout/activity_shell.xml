<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shell_page_background">

    <View
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-150dp"
        android:background="@drawable/shell_mist_blue" />

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-130dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/shell_mist_violet" />

    <WebView
        android:id="@+id/shell_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/shell_list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/shell_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@android:color/transparent"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:text="Supervisor"
                android:textColor="@color/weui_fg_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/shell_scan_header_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shell_scan_button"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/shell_scan_icon" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="76dp"
                android:paddingBottom="76dp">

                <LinearLayout
                    android:id="@+id/shell_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/shell_empty_title"
                        android:textColor="@color/weui_fg_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/shell_empty_hint"
                        android:textColor="@color/weui_fg_desc"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shell_scan_button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/shell_primary_button"
                        android:gravity="center"
                        android:minWidth="184dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/shell_scan_button"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/shell_section_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:gravity="center"
                    android:text="你的连接空间"
                    android:textColor="@color/weui_fg_desc"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/shell_instance_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</FrameLayout>
