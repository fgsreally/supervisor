+        <footer v-if="current.kind !== 'nav' || mobile">
@@
 const open = ref(false);
+const mobile = ref(false);
@@
 function start() {
+  mobile.value = window.matchMedia("(max-width: 767px)").matches;
@@
 .intro-next {
   color: white;
   background: #07c160;
 }
+
+@media (max-width: 767px) {
+  .intro-layer--mobile {
+    background: rgb(0 0 0 / 36%);
+    pointer-events: auto;
+  }
+
+  .intro-layer--mobile .intro-focus {
+    display: none;
+  }
+
+  .intro-layer--mobile .intro-popover {
+    inset: auto 0 0 !important;
+    width: 100% !important;
+    max-height: min(78dvh, 620px);
+    padding: 18px 16px calc(16px + env(safe-area-inset-bottom));
+    border: 0;
+    border-radius: 16px 16px 0 0;
+    background: var(--m-surface, var(--app-popup-bg));
+    box-shadow: 0 -8px 30px rgb(0 0 0 / 18%);
+    overscroll-behavior: contain;
+    transition: transform 180ms ease;
+  }
+
+  .intro-layer--mobile .intro-popover header button {
+    width: 44px;
+    height: 44px;
+    margin: -10px -10px -10px 0;
+  }
+
+  .intro-layer--mobile .intro-popover header svg {
+    width: 20px;
+    height: 20px;
+  }
+
+  .intro-layer--mobile .intro-popover h3 {
+    margin-top: 10px;
+    font-size: 20px;
+    line-height: 1.35;
+  }
+
+  .intro-layer--mobile .intro-popover > p {
+    font-size: 15px;
+    line-height: 1.65;
+  }
+
+  .intro-layer--mobile .intro-modules {
+    grid-template-columns: 1fr;
+  }
+
+  .intro-layer--mobile .intro-modules > div {
+    min-height: 48px;
+  }
+
+  .intro-layer--mobile .intro-modules strong {
+    font-size: 14px;
+  }
+
+  .intro-layer--mobile .intro-modules small {
+    font-size: 12px;
+    white-space: normal;
+  }
+
+  .intro-layer--mobile .intro-popover footer {
+    position: sticky;
+    bottom: calc(-16px - env(safe-area-inset-bottom));
+    margin: 18px -16px calc(-16px - env(safe-area-inset-bottom));
+    padding: 10px 16px calc(12px + env(safe-area-inset-bottom));
+    background: var(--m-surface, var(--app-popup-bg));
+  }
+
+  .intro-layer--mobile .intro-popover footer button {
+    min-height: 44px;
+    padding-inline: 18px;
+    font-size: 15px;
+  }
+
+  .intro-layer--mobile .intro-next {
+    flex: 1;
+  }
+}
