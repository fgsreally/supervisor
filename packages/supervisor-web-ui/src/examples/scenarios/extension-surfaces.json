{
  "id": "extension-surfaces",
  "project": {
    "id": "extension-surfaces",
    "title": { "zh-CN": "扩展交互", "en": "Extension surfaces" },
    "description": {
      "zh-CN": "集中查看扩展工具、交互卡片和失败状态",
      "en": "Preview extension tools, interaction cards, and failures"
    }
  },
  "session": {
    "id": "extension-gallery",
    "title": { "zh-CN": "扩展渲染展厅", "en": "Extension rendering gallery" },
    "description": {
      "zh-CN": "选择分支后发送任意内容，查看对应的扩展渲染",
      "en": "Send anything after choosing a branch to preview its extension rendering"
    }
  },
  "rounds": [
    {
      "branches": [
        {
          "id": "1",
          "label": { "zh-CN": "MCP 工具", "en": "MCP tool" },
          "assistant": {
            "zh-CN": "我调用了一个 MCP 日历工具，并把返回结果整理好了。",
            "en": "I called an MCP calendar tool and organized its result."
          },
          "tool": {
            "name": "mcp_calendar_create_event",
            "arguments": {
              "title": "设计评审",
              "start": "2026-08-24T10:00:00+08:00"
            },
            "result": {
              "zh-CN": "已创建日历事件：设计评审，明天 10:00。",
              "en": "Created calendar event: Design review, tomorrow at 10:00."
            }
          }
        },
        {
          "id": "2",
          "label": { "zh-CN": "服务管理", "en": "Service management" },
          "assistant": {
            "zh-CN": "预览服务已经启动，前端现在可以打开查看。",
            "en": "The preview service is running and ready to open."
          },
          "tool": {
            "name": "ProjectServiceStart",
            "arguments": { "serviceId": "web", "port": 5173 },
            "result": {
              "zh-CN": "服务 web 已启动：http://localhost:5173",
              "en": "Service web started: http://localhost:5173"
            }
          }
        },
        {
          "id": "3",
          "label": { "zh-CN": "定时任务", "en": "Timer" },
          "assistant": {
            "zh-CN": "我创建了一个稍后提醒。",
            "en": "I created a reminder for later."
          },
          "tool": {
            "name": "TimerCreate",
            "arguments": { "delaySeconds": 900, "prompt": "检查构建结果" },
            "result": {
              "zh-CN": "定时任务已创建，将在 15 分钟后触发。",
              "en": "Timer created; it will trigger in 15 minutes."
            }
          }
        }
      ]
    },
    {
      "branches": [
        {
          "id": "1",
          "label": { "zh-CN": "Ask 选择", "en": "Ask choice" },
          "assistant": {
            "zh-CN": "我先询问一次偏好，再继续执行。",
            "en": "I asked for a preference before continuing."
          },
          "tool": {
            "name": "ask",
            "arguments": {
              "questions": [
                {
                  "id": "style",
                  "prompt": "选择输出风格",
                  "options": [
                    { "value": "compact", "label": "简洁" },
                    { "value": "detailed", "label": "详细" }
                  ]
                }
              ]
            },
            "result": {
              "zh-CN": "{\"details\":{\"answers\":[{\"id\":\"style\",\"value\":\"compact\",\"label\":\"简洁\"}]}}",
              "en": "{\"details\":{\"answers\":[{\"id\":\"style\",\"value\":\"compact\",\"label\":\"Compact\"}]}}"
            }
          }
        },
        {
          "id": "2",
          "label": { "zh-CN": "外部审批", "en": "External approval" },
          "assistant": {
            "zh-CN": "这个操作需要外部审批，下面展示已处理状态。",
            "en": "This operation required external approval; here is the resolved state."
          },
          "tool": {
            "name": "external_interaction",
            "arguments": {
              "externalInteraction": true,
              "kind": "approval",
              "title": "允许执行部署命令？",
              "summary": "npm run deploy -- --preview",
              "backend": "extension",
              "interactionId": "demo-approval-1",
              "request": { "toolName": "bash", "input": { "command": "npm run deploy -- --preview" } }
            },
            "result": { "zh-CN": "approved", "en": "approved" }
          }
        },
        {
          "id": "3",
          "label": { "zh-CN": "子 Agent", "en": "Subagent" },
          "assistant": {
            "zh-CN": "我委派了一个子 Agent 做快速检查。",
            "en": "I delegated a quick check to a subagent."
          },
          "tool": {
            "name": "spawn_agent",
            "arguments": {
              "sessionId": "example:extension-surfaces:child",
              "agentName": "安全检查员",
              "description": "检查部署配置中的高风险项"
            },
            "result": {
              "zh-CN": "{\"sessionId\":\"example:extension-surfaces:child\"}",
              "en": "{\"sessionId\":\"example:extension-surfaces:child\"}"
            }
          }
        }
      ]
    },
    {
      "branches": [
        {
          "id": "1",
          "label": { "zh-CN": "MCP 失败", "en": "MCP failure" },
          "assistant": {
            "zh-CN": "MCP 服务返回了错误，请检查连接和权限。",
            "en": "The MCP service returned an error. Check its connection and permissions."
          },
          "tool": {
            "name": "mcp_database_query",
            "arguments": { "query": "SELECT * FROM protected_data" },
            "result": {
              "zh-CN": "permission denied: protected_data",
              "en": "permission denied: protected_data"
            },
            "isError": true
          }
        },
        {
          "id": "2",
          "label": { "zh-CN": "Bash 失败", "en": "Bash failure" },
          "assistant": {
            "zh-CN": "命令执行失败，下面可以打开终端详情查看。",
            "en": "The command failed; open the terminal detail to inspect it."
          },
          "tool": {
            "name": "bash",
            "arguments": { "command": "pnpm run build", "intent": "验证构建" },
            "result": {
              "zh-CN": "Command exited with code 1\nError: Cannot find module './entry'",
              "en": "Command exited with code 1\nError: Cannot find module './entry'"
            },
            "isError": true
          }
        },
        {
          "id": "3",
          "label": { "zh-CN": "Skill 加载", "en": "Skill loading" },
          "assistant": {
            "zh-CN": "我加载了一个 Skill，并按照其中的约定继续。",
            "en": "I loaded a Skill and continued according to its instructions."
          },
          "tool": {
            "name": "read",
            "arguments": { "path": ".pi/skills/review/SKILL.md" },
            "result": {
              "zh-CN": "---\nname: review\ndescription: Review changes\n---\n检查变更并给出建议。",
              "en": "---\nname: review\ndescription: Review changes\n---\nReview changes and provide suggestions."
            }
          }
        }
      ]
    }
  ]
}
